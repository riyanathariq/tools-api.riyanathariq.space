APP_ENV=development
HTTP_ADDR=:3003

# Public URL used for Google OAuth redirect + absolute links
PUBLIC_BASE_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000

# Long random string (32+ chars). Required.
SESSION_SECRET=dev-only-change-me-to-32chars-min
SESSION_COOKIE=tools_session
SESSION_TTL_HOURS=168
COOKIE_SECURE=false

# Google OAuth Web client
# Authorized JavaScript origin: https://tools.riyanathariq.space
# Authorized redirect URI:     https://tools.riyanathariq.space/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Postgres
POSTGRES_DB=tools
POSTGRES_USER=tools
POSTGRES_PASSWORD=tools
DATABASE_URL=postgres://tools:tools@127.0.0.1:5432/tools?sslmode=disable

# Valkey (Redis-compatible)
VALKEY_URL=redis://127.0.0.1:6379/0
